# === Meta WhatsApp Cloud API ===
# Encontrados no painel do seu app em developers.facebook.com > WhatsApp > API Setup
WHATSAPP_TOKEN=coloque_aqui_o_access_token
WHATSAPP_PHONE_NUMBER_ID=coloque_aqui_o_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=coloque_aqui_o_waba_id

# Token que você mesmo inventa (uma senha qualquer) — usado só para a Meta confirmar
# que o webhook é seu quando ela faz a verificação inicial.
WHATSAPP_VERIFY_TOKEN=escolha-uma-senha-aqui

# Número do Bruno (quem recebe as sugestões), formato internacional sem espaços/símbolos.
# Ex: 5581991720703
OWNER_WHATSAPP_NUMBER=

# === Anthropic (o "cérebro" da Sofia) ===
ANTHROPIC_API_KEY=coloque_aqui_sua_chave_da_api_anthropic

# === Servidor ===
PORT=3000

# === Transcrição de áudio (opcional na v1 — ver README) ===
# Se/quando ligar transcrição real, uma chave de um provedor de speech-to-text entra aqui.
# TRANSCRIBE_API_KEY=
